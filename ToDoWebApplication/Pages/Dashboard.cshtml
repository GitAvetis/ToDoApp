@page "{listId:int?}"
@using ToDoWebApplication.Domain.Models
@model ToDoWebApplication.Pages.DashboardModel

<div style="display:flex; gap:20px">

    <!-- LEFT: LISTS -->
    <div style="width:250px; border-right:1px solid #ccc">
        <h3>Lists</h3>

        <!-- Create list -->
        <form method="post" asp-page-handler="CreateList">
            <input asp-for="NewListName"
                   placeholder="New list name"
                   autofocus />
            <button>Add</button>
        </form>

        <ul>
            @foreach (var list in Model.Lists)
            {
                <li>
                    @if (Model.EditingListId == list.Id)
                    {
                        <form method="post"
                              asp-page-handler="UpdateList"
                              style="display:inline">

                            <input type="hidden" name="listId" value="@list.Id" />

                            <input type="text"
                                   name="EditedListName"
                                   value="@list.Name"
                                   autofocus
                                   onkeydown="cancelEditOnEscape(event)" />

                            <button>💾</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Dashboard"
                           asp-route-listId="@list.Id">
                            @list.Name
                        </a>

                        <form method="post"
                              asp-page-handler="StartEditList"
                              style="display:inline">
                            <input type="hidden" name="listId" value="@list.Id" />
                            <button style="all:unset; cursor:pointer;">✏️</button>
                        </form>

                        <form method="post"
                              asp-page-handler="DeleteList"
                              style="display:inline">
                            <input type="hidden" name="listId" value="@list.Id" />
                            <button>❌</button>
                        </form>
                    }
                </li>
            }
        </ul>
    </div>

    <!-- RIGHT: TASKS -->
    <div style="flex:1">
        <h3>Tasks</h3>

        @if (Model.SelectedListId != null)
        {
            <!-- Create task -->
            <form method="post" asp-page-handler="CreateTask">
                <input type="hidden" asp-for="SelectedListId" />
                <input asp-for="NewTaskDescription"
                       placeholder="New task"
                       autofocus />
                <button>Add task</button>
            </form>

            <ul>
                @foreach (var task in Model.Tasks)
                {
                    <li>
                        <!-- Toggle -->
                        <form method="post"
                              asp-page-handler="ToggleTask"
                              style="display:inline">

                            <input type="hidden" name="listId" value="@Model.SelectedListId" />
                            <input type="hidden" name="taskId" value="@task.Id" />

                            <input type="checkbox"
                                   name="isCompleted"
                                   value="true"
                                   onchange="this.form.submit()"
                                   @(task.IsCompleted ? "checked" : "") />
                        </form>

                        <!-- Inline edit -->
                        @if (Model.EditingTaskId == task.Id)
                        {
                            <form method="post"
                                  asp-page-handler="UpdateTask"
                                  style="display:inline">

                                <input type="hidden" name="listId" value="@Model.SelectedListId" />
                                <input type="hidden" name="taskId" value="@task.Id" />

                                <input type="text"
                                       name="EditedTaskDescription"
                                       value="@task.Description"
                                       autofocus
                                       onkeydown="cancelEditOnEscape(event)" />

                                <button>💾</button>
                            </form>
                        }
                        else
                        {
                            <span style="@(task.IsCompleted ? "text-decoration:line-through" : "")">
                                @task.Description
                            </span>

                            <form method="post"
                                  asp-page-handler="StartEditTask"
                                  style="display:inline">
                                <input type="hidden" name="taskId" value="@task.Id" />
                                <input type="hidden" name="listId" value="@Model.SelectedListId" />
                                <button style="all:unset; cursor:pointer;">✏️</button>
                            </form>
                        }

                        <!-- Delete -->
                        <form method="post"
                              asp-page-handler="DeleteTask"
                              style="display:inline">
                            <input type="hidden" name="taskId" value="@task.Id" />
                            <input type="hidden" name="listId" value="@Model.SelectedListId" />
                            <button>❌</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Select a list</p>
        }
    </div>

</div>

<script>
    function cancelEditOnEscape(event) {
        if (event.key === "Escape") {
            window.location.href = window.location.pathname;
        }
    }
</script>
